[Unit]
Description=API Server for Klipper
Requires=klipper.service
# ustreamer is not started by this, but it stays loaded: Moonraker only lists services
# that systemd has loaded, and an inactive unit nobody references is unloaded
After=network-online.target klipper.service ustreamer.service

[Service]
Type=simple
User=klipper
RemainAfterExit=no
WorkingDirectory=/var/lib/klipper/moonraker
ExecStart=/var/lib/klipper/moonraker-env/bin/python /var/lib/klipper/moonraker/moonraker/moonraker.py -c /etc/klipper/moonraker.conf -l /var/log/moonraker/moonraker.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
