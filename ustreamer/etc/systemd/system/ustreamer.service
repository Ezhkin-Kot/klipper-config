[Unit]
Description=uStreamer webcam
After=network.target

[Service]
User=klipper
SupplementaryGroups=video
ExecStart=/usr/bin/ustreamer \
  --device=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._Autodarts_DIY_Cam_SN0001-video-index0 \
  --format=MJPEG --resolution=1280x720 --desired-fps=15 --slowdown \
  --device-timeout=2 \
  --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
